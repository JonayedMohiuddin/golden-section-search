\begin{tikzpicture}
  \begin{axis}[
    width=6.85cm,
    height=4.05cm,
    axis lines=left,
    xmin=0, xmax=5,
    ymin=0, ymax=4.8,
    xtick={2.2},
    xticklabels={$x^*$},
    ytick=\empty,
    xlabel={$x$},
    ylabel={$f(x)$},
    label style={font=\small},
    tick label style={font=\small},
    every axis plot/.append style={line width=1.4pt},
    clip=false
  ]
    \addplot[GSInk,domain=0.15:4.7,samples=90]
      {4.25 - 0.78*(x-2.2)^2};
    \addplot[GSGold,only marks,mark=*,mark size=2.4pt]
      coordinates {(2.2,4.25)};
    \draw[GSGold,densely dashed,line width=1pt]
      (axis cs:2.2,0) -- (axis cs:2.2,4.25);
    \node[GSInk,font=\scriptsize,anchor=south,yshift=2pt,
      fill=GSCream,fill opacity=0.94,text opacity=1,inner sep=1.2pt]
      at (axis cs:1.05,3.22) {nondecreasing};
    \node[GSInk,font=\scriptsize,anchor=south,yshift=2pt,
      fill=GSCream,fill opacity=0.94,text opacity=1,inner sep=1.2pt]
      at (axis cs:3.45,3.03) {nonincreasing};
  \end{axis}
\end{tikzpicture}
