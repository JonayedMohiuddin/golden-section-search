\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{styles/golden-section-theme}[2026/10/02 Golden-section Beamer style]

% Editorial palette: warm paper, deep navy, and restrained metallic accents.
\definecolor{GSCream}{HTML}{F8F5EE}
\definecolor{GSInk}{HTML}{132238}
\definecolor{GSNavy}{HTML}{1C3455}
\definecolor{GSGold}{HTML}{B7791F}
\definecolor{GSMuted}{HTML}{667385}
\definecolor{GSPaleGold}{HTML}{F1E5CB}
\definecolor{GSCoral}{HTML}{BB5548}
\definecolor{GSTeal}{HTML}{2E7774}
\definecolor{GSPaleTeal}{HTML}{DCEBE8}
\definecolor{GSHairline}{HTML}{D8D2C6}

\mode<presentation>

\usefonttheme{professionalfonts}
\setbeamercolor{normal text}{fg=GSInk,bg=GSCream}
\setbeamercolor{background canvas}{bg=GSCream}
\setbeamercolor{structure}{fg=GSTeal}
\setbeamercolor{alerted text}{fg=GSCoral}
\setbeamercolor{frametitle}{fg=white,bg=GSInk}
\setbeamercolor{title}{fg=white}
\setbeamercolor{subtitle}{fg=white!72}
\setbeamercolor{author}{fg=white}
\setbeamercolor{date}{fg=white!62}
\setbeamercolor{section in toc}{fg=GSInk}
\setbeamercolor{subsection in toc}{fg=GSMuted}
\setbeamercolor{block title}{fg=white,bg=GSTeal}
\setbeamercolor{block body}{fg=GSInk,bg=GSPaleTeal!55!white}

\setbeamerfont{title}{series=\bfseries,size=\fontsize{50}{52}}
\setbeamerfont{subtitle}{size=\fontsize{18}{22}}
\setbeamerfont{author}{series=\bfseries,size=\fontsize{18}{22}}
\setbeamerfont{date}{size=\fontsize{14}{18}}
\setbeamerfont{frametitle}{series=\bfseries,size=\fontsize{35}{38}}
\setbeamerfont{normal text}{size=\fontsize{16}{20}}
\setbeamerfont{itemize/enumerate body}{size=\fontsize{16}{20}}
\setbeamerfont{itemize/enumerate subbody}{size=\fontsize{14}{18}}
\setbeamerfont{block title}{series=\bfseries,size=\fontsize{17}{21}}
\setbeamerfont{block body}{size=\fontsize{16}{20}}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{itemize item}{\raise0.18ex\hbox{\color{GSTeal}\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\raise0.12ex\hbox{\color{GSGold}\tiny$\bullet$}}
\setbeamertemplate{enumerate item}{%
  \tikz[baseline=(n.base)]\node[fill=GSGold,text=white,circle,
    minimum size=1.6em,inner sep=0pt,font=\bfseries\small] (n) {\insertenumlabel};}
\setbeamertemplate{blocks}[default]

% A dark editorial masthead creates a consistent visual anchor.
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=1.10cm,dp=0.23cm,
    leftskip=0.76cm,rightskip=0.76cm]{frametitle}
    \usebeamerfont{frametitle}\strut\insertframetitle
  \end{beamercolorbox}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[GSGold]
      ([yshift=-1.33cm]current page.north west)
      rectangle ([xshift=3.05cm,yshift=-1.28cm]current page.north west);
    \fill[GSTeal]
      ([xshift=3.05cm,yshift=-1.33cm]current page.north west)
      rectangle ([yshift=-1.28cm]current page.north east);
  \end{tikzpicture}%
}

% A quiet footer: identity on the left, progress on the right.
\setbeamertemplate{footline}{%
  \leavevmode
  \color{GSHairline}\rule{\paperwidth}{0.35pt}\par\nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth,ht=0.31cm,dp=0.15cm,
    leftskip=0.76cm,rightskip=0.76cm]{normal text}%
    \color{GSMuted}\fontsize{8.5}{10}\selectfont
    Jonayed Mohiuddin \enspace\textcolor{GSGold}{\textbullet}\enspace 2105060
    \hfill
    \textcolor{GSInk}{\bfseries\insertframenumber}
    \textcolor{GSMuted}{\,/\,\inserttotalframenumber}
  \end{beamercolorbox}%
}

\setbeamersize{text margin left=0.76cm,text margin right=0.76cm}

% Dark title page with a restrained phi watermark and asymmetric rules.
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[GSInk] (current page.south west) rectangle (current page.north east);
    \fill[GSGold] (current page.north west)
      rectangle ([xshift=0.16cm]current page.south west);
    \fill[GSTeal]
      ([xshift=-1.15cm]current page.north east)
      rectangle (current page.south east);
    \node[anchor=south east,text=white,opacity=0.055,
      font=\fontsize{146}{146}\selectfont\bfseries]
      at ([xshift=-0.56cm,yshift=-0.30cm]current page.south east) {$\varphi$};
    \draw[GSGold,line width=1.7pt]
      ([xshift=0.84cm,yshift=-2.02cm]current page.north west) --
      ([xshift=4.75cm,yshift=-2.02cm]current page.north west);
    \draw[white!18,line width=0.5pt]
      ([xshift=0.84cm,yshift=0.95cm]current page.south west) --
      ([xshift=-1.65cm,yshift=0.95cm]current page.south east);
  \end{tikzpicture}
  \vspace*{0.18cm}
  {\color{GSGold}\fontsize{14}{18}\selectfont\bfseries
    CSE 401 \enspace\textcolor{white!35}{/}\enspace
    NUMERICAL ANALYSIS AND SIMULATION\par}
  \vspace{0.90cm}
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
  \vspace{0.25cm}
  {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
  \vfill
  {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
  \vspace{0.10cm}
  {\color{white!62}\fontsize{14}{18}\selectfont Student ID: 2105060\par}
  \vspace{0.28cm}
  {\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}
  \vspace*{0.18cm}
}

% Section dividers use one large numeral as the visual motif.
\AtBeginSection[]{%
  \setbeamercolor{background canvas}{bg=GSInk}
  \begin{frame}[plain]
    \begin{tikzpicture}[remember picture,overlay]
      \fill[GSGold] (current page.north west)
        rectangle ([xshift=0.16cm]current page.south west);
      \node[anchor=north east,text=white,opacity=0.06,
        font=\fontsize{132}{132}\selectfont\bfseries]
        at ([xshift=-0.60cm,yshift=-0.18cm]current page.north east)
        {\insertsectionnumber};
      \draw[GSTeal,line width=2pt]
        ([xshift=0.82cm,yshift=-1.58cm]current page.north west) --
        ([xshift=4.20cm,yshift=-1.58cm]current page.north west);
    \end{tikzpicture}
    \vspace*{0.34cm}
    {\color{GSGold}\fontsize{14}{18}\selectfont\bfseries
      SECTION \insertsectionnumber\par}
    \vspace{0.96cm}
    {\color{white}\fontsize{38}{44}\selectfont\bfseries
      \begin{minipage}{0.76\textwidth}\raggedright
        \insertsectionhead
      \end{minipage}\par}
    \vfill
    {\color{white!58}\fontsize{13}{17}\selectfont
      Golden-Section Search \enspace\textcolor{GSGold}{\textbullet}\enspace
      Jonayed Mohiuddin\par}
    \vspace*{0.25cm}
  \end{frame}
  \setbeamercolor{background canvas}{bg=GSCream}
}

% Small semantic helpers for later teaching and solution frames.
\newcommand{\golden}[1]{\textcolor{GSGold}{\textbf{#1}}}
\newcommand{\muted}[1]{\textcolor{GSMuted}{#1}}
\newcommand{\sourceline}[1]{%
  \par\vspace{0.15cm}{\color{GSMuted}\fontsize{8.5}{10}\selectfont
    \textit{Reference: #1}}}

\newenvironment{keyidea}[1][Key idea]
  {\begin{block}{#1}}
  {\end{block}}

\mode<all>
